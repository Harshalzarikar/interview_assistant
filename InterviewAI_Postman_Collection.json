{
  "info": {
    "name": "InterviewAI Backend API",
    "description": "API endpoints for the InterviewAI (Artizence) backend: mock interview links, LiveKit tokens, and post-interview transcript/analysis.\n\nQuick start:\n1. Set `base_url` (default http://localhost:8000, or https://interview-assistant-795o.onrender.com for prod).\n2. Run `Create Mock Interview Link` (full details) or `Create Mock Interview Room (job only)` (just job_title + job_description) — `session_id`/`room_id` and the generated link are auto-saved to collection variables.\n3. After the interview: `Get Mock Interview Result` (or `Get Mock Interview Details`) for transcript + analysis.\n4. Use `Join Mock Interview` for LiveKit credentials, or `Complete Mock Interview` to test analysis without the UI.\n\nAll routes are served by FastAPI in backend/api.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Catalog",
      "item": [
        {
          "name": "Root Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Health check for the FastAPI server. Returns { message, status }."
          }
        },
        {
          "name": "Get Interviewers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/interviewers",
              "host": ["{{base_url}}"],
              "path": ["api", "interviewers"]
            },
            "description": "Returns the catalog of available AI interviewers (alex, harry)."
          }
        }
      ]
    },
    {
      "name": "Mock Interviews",
      "item": [
        {
          "name": "Create Mock Interview Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('session_id', body.session_id);",
                  "  pm.collectionVariables.set('interview_link', body.interview_link);",
                  "  pm.test('status is pending', () => pm.expect(body.status).to.eql('pending'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interviewer_id\": \"alex\",\n  \"candidate_name\": \"John Doe\",\n  \"candidate_email\": \"john@example.com\",\n  \"job_title\": \"Software Engineer\",\n  \"job_description\": \"Python backend role with FastAPI experience.\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mock-interviews",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interviews"]
            },
            "description": "Creates a mock interview session and returns `interview_link` for the candidate. Saves `session_id` and `interview_link` to collection variables for follow-up calls.\n\nBody: interviewer_id, candidate_name, candidate_email are required; job_title, job_description, language are optional (language defaults to \"en\", use \"hi\" for Hindi)."
          }
        },
        {
          "name": "Create Mock Interview Room (job only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('room_id', body.room_id);",
                  "  pm.collectionVariables.set('session_id', body.room_id);",
                  "  pm.collectionVariables.set('mock_interview_room_url', body.mock_interview_room_url);",
                  "  pm.test('room url contains /room/', () => pm.expect(body.mock_interview_room_url).to.include('/room/'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_title\": \"Software Engineer\",\n  \"job_description\": \"Python backend role with FastAPI experience.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mock-interview-rooms",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interview-rooms"]
            },
            "description": "Creates a mock interview room from just a job title and description and returns `mock_interview_room_url` (resolves to the /room/{room_id} join page). Saves `room_id` and `mock_interview_room_url` to collection variables."
          }
        },
        {
          "name": "Get Mock Interview Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mock-interviews/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interviews", "{{session_id}}"]
            },
            "description": "Returns session metadata, `transcript`, and `analysis` (null until the interview is completed). Status: pending | in_progress | completed.\n\nSame response as **Get Mock Interview Result** (`/result`)."
          }
        },
        {
          "name": "Get Mock Interview Result",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mock-interviews/{{session_id}}/result",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interviews", "{{session_id}}", "result"]
            },
            "description": "Primary integration endpoint for transcript and analysis after a mock interview. Use `session_id` from **Create Mock Interview Link** or **Create Mock Interview Room**. Returns the same JSON as **Get Mock Interview Details**.\n\n- `transcript`: empty until the candidate finishes (or you call **Complete Mock Interview**)\n- `analysis`: null until `status` is `completed`"
          }
        },
        {
          "name": "Join Mock Interview",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('livekit_token', body.token);",
                  "  pm.collectionVariables.set('room_name', body.room_name);",
                  "  pm.collectionVariables.set('livekit_url', body.livekit_url);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mock-interviews/{{session_id}}/join",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interviews", "{{session_id}}", "join"]
            },
            "description": "Returns LiveKit credentials (token, room_name, livekit_url) for the candidate join page and flips status to in_progress. Returns 400 if the interview is already completed; 404 if the session is unknown."
          }
        },
        {
          "name": "Complete Mock Interview (manual / test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('status is completed', () => pm.expect(body.status).to.eql('completed'));",
                  "  pm.test('analysis has detailed report fields', () => {",
                  "    const a = body.analysis || {};",
                  "    pm.expect(a).to.have.property('score');",
                  "    pm.expect(a).to.have.property('readiness');",
                  "    pm.expect(a.dimensions).to.be.an('array').with.lengthOf(5);",
                  "    pm.expect(a).to.have.property('strengths');",
                  "    pm.expect(a).to.have.property('weaknesses');",
                  "    pm.expect(a).to.have.property('recommendations');",
                  "    pm.expect(a).to.have.property('question_breakdown');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transcript\": [\n    {\n      \"id\": \"1\",\n      \"speakerName\": \"AI Interviewer\",\n      \"text\": \"Hello John, welcome to the interview.\",\n      \"isAgent\": true,\n      \"isFinal\": true\n    },\n    {\n      \"id\": \"2\",\n      \"speakerName\": \"You\",\n      \"text\": \"Hi, thank you for having me!\",\n      \"isAgent\": false,\n      \"isFinal\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mock-interviews/{{session_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interviews", "{{session_id}}", "complete"]
            },
            "description": "Saves transcript, runs Groq analysis, and marks the session completed. Use after create to test GET details without joining the UI."
          }
        }
      ]
    },
    {
      "name": "Legacy / Direct",
      "item": [
        {
          "name": "Start Interview (direct token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interviewer_id\": \"alex\",\n  \"candidate_name\": \"John Doe\",\n  \"candidate_email\": \"john@example.com\",\n  \"job_title\": \"Software Engineer\",\n  \"job_description\": \"We are looking for a Python developer.\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/start-interview",
              "host": ["{{base_url}}"],
              "path": ["api", "start-interview"]
            },
            "description": "Generates a LiveKit token without creating a persisted mock session. Returns token, room_name, livekit_url, interviewer."
          }
        },
        {
          "name": "Get Interviewer Prompt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/interviewer/alex/prompt?candidate_name=John Doe&job_title=Software Engineer&language=en",
              "host": ["{{base_url}}"],
              "path": ["api", "interviewer", "alex", "prompt"],
              "query": [
                { "key": "candidate_name", "value": "John Doe" },
                { "key": "job_title", "value": "Software Engineer" },
                { "key": "job_description", "value": "", "disabled": true },
                { "key": "language", "value": "en" }
              ]
            },
            "description": "Used by the LiveKit agent to fetch the customized system prompt for an interviewer."
          }
        },
        {
          "name": "Analyze Interview",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('score is a number from 0 to 10', () => pm.expect(body.score).to.be.a('number').within(0, 10));",
                  "  pm.test('has detailed report fields', () => {",
                  "    pm.expect(body).to.have.property('readiness');",
                  "    pm.expect(body).to.have.property('summary');",
                  "    pm.expect(body.dimensions).to.be.an('array').with.lengthOf(5);",
                  "    pm.expect(body).to.have.property('strengths');",
                  "    pm.expect(body).to.have.property('weaknesses');",
                  "    pm.expect(body).to.have.property('feedback');",
                  "    pm.expect(body).to.have.property('recommendations');",
                  "    pm.expect(body).to.have.property('question_breakdown');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transcript\": [\n    {\n      \"speakerName\": \"AI Interviewer\",\n      \"text\": \"Hello John, welcome to the interview.\"\n    },\n    {\n      \"speakerName\": \"You\",\n      \"text\": \"Hi, thank you for having me!\"\n    }\n  ],\n  \"interviewer_id\": \"alex\",\n  \"candidate_name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/analyze-interview",
              "host": ["{{base_url}}"],
              "path": ["api", "analyze-interview"]
            },
            "description": "Sends a transcript to Groq and returns a detailed report: score (0-10), readiness, summary, dimensions (Communication, Technical Depth, Problem Solving, Clarity, Confidence), strengths, weaknesses, feedback, recommendations, and a question_breakdown. Requires GROQ_API_KEY on the server."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "interview_link",
      "value": "",
      "type": "string"
    },
    {
      "key": "room_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "mock_interview_room_url",
      "value": "",
      "type": "string"
    },
    {
      "key": "livekit_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "room_name",
      "value": "",
      "type": "string"
    },
    {
      "key": "livekit_url",
      "value": "",
      "type": "string"
    }
  ]
}
