{
  "info": {
    "name": "InterviewAI Backend API",
    "description": "API endpoints for the InterviewAI backend: mock interview links, LiveKit tokens, and post-interview transcript/analysis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Catalog",
      "item": [
        {
          "name": "Root Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Health check for the FastAPI server."
          }
        },
        {
          "name": "Get Interviewers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/interviewers",
              "host": ["{{base_url}}"],
              "path": ["api", "interviewers"]
            },
            "description": "Returns the catalog of available AI interviewers (e.g. alex, harry)."
          }
        }
      ]
    },
    {
      "name": "Mock Interviews",
      "item": [
        {
          "name": "Create Mock Interview Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('session_id', body.session_id);",
                  "  pm.collectionVariables.set('interview_link', body.interview_link);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interviewer_id\": \"alex\",\n  \"candidate_name\": \"John Doe\",\n  \"candidate_email\": \"john@example.com\",\n  \"job_title\": \"Software Engineer\",\n  \"job_description\": \"Python backend role with FastAPI experience.\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mock-interviews",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interviews"]
            },
            "description": "Creates a mock interview session and returns `interview_link` for the candidate. Saves `session_id` to collection variables for follow-up calls."
          }
        },
        {
          "name": "Get Mock Interview Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mock-interviews/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interviews", "{{session_id}}"]
            },
            "description": "Returns session metadata, `transcript`, and `analysis` (null until the interview is completed). Status: pending | in_progress | completed."
          }
        },
        {
          "name": "Complete Mock Interview (manual / test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transcript\": [\n    {\n      \"id\": \"1\",\n      \"speakerName\": \"AI Interviewer\",\n      \"text\": \"Hello John, welcome to the interview.\",\n      \"isAgent\": true,\n      \"isFinal\": true\n    },\n    {\n      \"id\": \"2\",\n      \"speakerName\": \"You\",\n      \"text\": \"Hi, thank you for having me!\",\n      \"isAgent\": false,\n      \"isFinal\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mock-interviews/{{session_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "mock-interviews", "{{session_id}}", "complete"]
            },
            "description": "Saves transcript, runs Groq analysis, and marks the session completed. Use after create to test GET details without joining the UI."
          }
        }
      ]
    },
    {
      "name": "Legacy / Direct",
      "item": [
        {
          "name": "Start Interview (direct token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interviewer_id\": \"alex\",\n  \"candidate_name\": \"John Doe\",\n  \"candidate_email\": \"john@example.com\",\n  \"job_title\": \"Software Engineer\",\n  \"job_description\": \"We are looking for a Python developer.\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/start-interview",
              "host": ["{{base_url}}"],
              "path": ["api", "start-interview"]
            },
            "description": "Generates a LiveKit token without creating a persisted mock session."
          }
        },
        {
          "name": "Get Interviewer Prompt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/interviewer/alex/prompt?candidate_name=John Doe&job_title=Software Engineer&language=en",
              "host": ["{{base_url}}"],
              "path": ["api", "interviewer", "alex", "prompt"],
              "query": [
                { "key": "candidate_name", "value": "John Doe" },
                { "key": "job_title", "value": "Software Engineer" },
                { "key": "job_description", "value": "", "disabled": true },
                { "key": "language", "value": "en" }
              ]
            },
            "description": "Used by the LiveKit agent to fetch the customized system prompt."
          }
        },
        {
          "name": "Analyze Interview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transcript\": [\n    {\n      \"speakerName\": \"AI Interviewer\",\n      \"text\": \"Hello John, welcome to the interview.\"\n    },\n    {\n      \"speakerName\": \"You\",\n      \"text\": \"Hi, thank you for having me!\"\n    }\n  ],\n  \"interviewer_id\": \"alex\",\n  \"candidate_name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/analyze-interview",
              "host": ["{{base_url}}"],
              "path": ["api", "analyze-interview"]
            },
            "description": "Sends a transcript to Groq and returns strengths, weaknesses, feedback, and score."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "interview_link",
      "value": "",
      "type": "string"
    }
  ]
}
